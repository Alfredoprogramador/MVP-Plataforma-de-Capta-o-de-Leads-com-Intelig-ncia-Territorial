# Application Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/leads_platform
SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/leads_platform

# WhatsApp Cloud API Configuration
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Twilio Configuration (Alternative)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
WEBHOOK_BASE_URL=https://your-domain.com

# Lead Scoring Configuration
HOT_LEAD_THRESHOLD=70
WARM_LEAD_THRESHOLD=40
COLD_LEAD_THRESHOLD=0

# File Storage
UPLOAD_FOLDER=/tmp/uploads
MAX_CONTENT_LENGTH=16777216

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
